# ─────────────────────────────────────────────────────────────
# AmpWave Events – Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask secret key – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── SMTP / Email ──────────────────────────────────────────────
# The address Flask logs in to for sending mail.
# For Gmail, create an App Password at myaccount.google.com/apppasswords
# For other providers, use their SMTP credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASSWORD=your-app-password-here

# The public-facing AmpWave inbox (enquiries land here)
CONTACT_EMAIL=info@ampwave.events

# ── Cloudflare Turnstile ──────────────────────────────────────
# Get your keys at dash.cloudflare.com → Turnstile → Add widget
# Use the "Managed" widget type for automatic challenge decisions.
#
# During local development you can use Cloudflare's always-pass test keys:
#   SITE_KEY:   0x4AAAAAADG3eQMY-JejKNz7
#   SECRET_KEY: 0x4AAAAAADG3eSDRa4aUjQiH9t9T-UM0XA8
TURNSTILE_SITE_KEY=0x4AAAAAADG3eQMY-JejKNz7
TURNSTILE_SECRET_KEY=0x4AAAAAADG3eSDRa4aUjQiH9t9T-UM0XA8

# ── Flask runtime (optional) ──────────────────────────────────
# Set to "production" on the server; "development" locally
FLASK_ENV=production
